<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- Left Column (48% width): Hero Toggle + Duration + Tap Behavior + Quick Settings & Widget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="0.48"
            android:orientation="vertical">

            <!-- Hero Interactive Coffee Cup Toggle Card -->
            <LinearLayout
                android:id="@+id/card_hero_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <com.meridian11.books.awake.ui.CoffeeCupPictogramView
                    android:id="@+id/coffee_cup_hero"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/awake_sans"
                        android:letterSpacing="-0.01"
                        android:singleLine="true"
                        android:text="Normal Sleep"
                        android:textColor="@color/dialog_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_status_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/awake_sans"
                        android:lineSpacingExtra="2dp"
                        android:text="Half-Empty Cup • Normal sleep"
                        android:textColor="@color/dialog_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_master_awake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_m3_switch_thumb"
                    android:track="@drawable/bg_m3_switch_track_hero" />
            </LinearLayout>

            <!-- Session Duration Presets Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/awake_sans"
                    android:text="Keep-Awake Duration"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_segmented_track"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btn_duration_indefinite"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1.15"
                        android:background="@drawable/bg_chip_selected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="Infinite"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_selected_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_duration_30m"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="30m"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_duration_1h"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="1h"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_duration_2h"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="2h"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Taskbar Icon Tap Behavior ("Hide settings, tap icon to toggle") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/awake_sans"
                            android:text="Hide settings, tap icon to toggle"
                            android:textColor="@color/dialog_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_direct_toggle_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/awake_sans"
                            android:lineSpacingExtra="2dp"
                            android:text="Off: Tapping Taskbar icon opens window (turn ON for 1-click toggle)"
                            android:textColor="@color/dialog_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_direct_toggle_on_tap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:showText="false"
                        android:splitTrack="false"
                        android:thumb="@drawable/bg_m3_switch_thumb"
                        android:track="@drawable/bg_m3_switch_track" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Settings Tile & 1x1 Squircle Widget Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/awake_sans"
                    android:text="Quick Settings Tile &amp; Squircle Widget"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_qs_tile_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/awake_sans"
                    android:lineSpacingExtra="2dp"
                    android:text="Quick Settings Tile: Tap system tray tile to toggle Awake, or long-press for Settings."
                    android:textColor="@color/dialog_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_add_qs_tile"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_selected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="＋ Quick Settings Tile"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_selected_text"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_pin_widget"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="＋ Squircle Widget"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column (52% width): Simulated Tap Fallback + Smart Googlebook Guardrails -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="0.52"
            android:orientation="vertical">

            <!-- Simulated Tap / Click Fallback Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/awake_sans"
                            android:text="Simulate Tap / Click Fallback"
                            android:textColor="@color/dialog_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_tap_interval_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/awake_sans"
                            android:text="Micro-tap corner pixel every 60s if WakeLock blocked"
                            android:textColor="@color/dialog_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_tap_simulation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:showText="false"
                        android:splitTrack="false"
                        android:thumb="@drawable/bg_m3_switch_thumb"
                        android:track="@drawable/bg_m3_switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_segmented_track"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btn_tap_15s"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="15s"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_tap_30s"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="30s"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_tap_60s"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_selected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="60s"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_selected_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_tap_120s"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:ellipsize="none"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="120s"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_accessibility_setup"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:ellipsize="none"
                    android:fontFamily="@font/awake_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:stateListAnimator="@null"
                    android:text="Enable Accessibility Service for Tap Simulation →"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Smart Googlebook Guardrails Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/awake_sans"
                    android:text="Smart Googlebook Guardrails"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switch_lid_close_shutoff"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/awake_sans"
                    android:showText="false"
                    android:splitTrack="false"
                    android:text="Backpack Safety: Auto-Off When Lid Closes"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="13sp"
                    android:thumb="@drawable/bg_m3_switch_thumb"
                    android:track="@drawable/bg_m3_switch_track" />

                <Switch
                    android:id="@+id/switch_low_battery_cutoff"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:fontFamily="@font/awake_sans"
                    android:showText="false"
                    android:splitTrack="false"
                    android:text="Battery Guard: Auto-Off Below 20% Unplugged"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="13sp"
                    android:thumb="@drawable/bg_m3_switch_thumb"
                    android:track="@drawable/bg_m3_switch_track" />

                <Switch
                    android:id="@+id/switch_auto_awake_charger"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:fontFamily="@font/awake_sans"
                    android:showText="false"
                    android:splitTrack="false"
                    android:text="Plug-in Brew: Auto-Awake on AC Charger"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="13sp"
                    android:thumb="@drawable/bg_m3_switch_thumb"
                    android:track="@drawable/bg_m3_switch_track" />

                <Switch
                    android:id="@+id/switch_allow_dimming"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:fontFamily="@font/awake_sans"
                    android:showText="false"
                    android:splitTrack="false"
                    android:text="Allow Screen Dimming While Keeping Awake"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="13sp"
                    android:thumb="@drawable/bg_m3_switch_thumb"
                    android:track="@drawable/bg_m3_switch_track" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_close_settings"
                        android:layout_width="110dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_selected"
                        android:fontFamily="@font/awake_sans"
                        android:includeFontPadding="false"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:stateListAnimator="@null"
                        android:text="Done"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_selected_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
