<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <size android:width="22dp" android:height="22dp" />
                    <solid android:color="@color/switch_thumb_on" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <size android:width="18dp" android:height="18dp" />
                    <solid android:color="@color/switch_thumb_off" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
