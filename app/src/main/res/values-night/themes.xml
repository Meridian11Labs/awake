    <style name="Theme.Awake.SettingsDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/awake_sans</item>
        <item name="fontFamily">@font/awake_sans</item>
        <item name="colorPrimary">@color/window_bg</item>
