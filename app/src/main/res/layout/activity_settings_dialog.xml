<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero Interactive Coffee Cup Toggle Card -->
        <LinearLayout
            android:id="@+id/card_hero_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_card_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <com.meridian11.books.awake.ui.CoffeeCupPictogramView
                android:id="@+id/coffee_cup_hero"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Half-Empty • Normal Sleep"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Half-Empty Cup • Normal Suspend/Resume"
                    android:textColor="@color/dialog_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_master_awake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Card 2: Taskbar Icon Tap Behavior ("Hide settings, tap icon to toggle") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hide settings, tap icon to toggle"
                        android:textColor="@color/dialog_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_direct_toggle_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="When enabled, clicking the Taskbar icon toggles Awake immediately with no window (right-click the Taskbar icon or long-press the Quick Settings tile to open Settings)."
                        android:textColor="@color/dialog_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_direct_toggle_on_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Session Duration Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep-Awake Duration"
                android:textColor="@color/dialog_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_duration_indefinite"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:text="∞ Indefinite"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_selected_text" />

                <Button
                    android:id="@+id/btn_duration_30m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="30m"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text" />

                <Button
                    android:id="@+id/btn_duration_1h"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="1h"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text" />

                <Button
                    android:id="@+id/btn_duration_2h"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="2h"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 4: Quick Settings Tile & 1x1 Squircle Widget -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Settings Tile &amp; Squircle Widget"
                android:textColor="@color/dialog_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_qs_tile_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quick Settings Tile: Tap the Awake coffee cup tile in your Googlebook system tray to toggle between Filled (Active) and Half-Empty (Normal Sleep), or long-press the Quick Settings tile to open these Settings anytime."
                android:textColor="@color/dialog_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_qs_tile"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:text="＋ Add Quick Settings Tile"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_selected_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_pin_widget"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="＋ Pin Squircle Widget"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 5: Simulated Tap / Click Fallback -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulate Tap / Click Fallback"
                        android:textColor="@color/dialog_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tap_interval_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Micro-tap corner pixel every 60s if WakeLock blocked"
                        android:textColor="@color/dialog_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_tap_simulation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_tap_15s"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="15s"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text" />

                <Button
                    android:id="@+id/btn_tap_30s"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="30s"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text" />

                <Button
                    android:id="@+id/btn_tap_60s"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:text="60s"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_selected_text" />

                <Button
                    android:id="@+id/btn_tap_120s"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="120s"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_unselected_text" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_accessibility_setup"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="Enable Accessibility Service for Tap Simulation →"
                android:textAllCaps="false"
                android:textColor="@color/chip_unselected_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card 6: Smart Googlebook Guardrails -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Googlebook Guardrails"
                android:textColor="@color/dialog_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switch_lid_close_shutoff"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:text="Backpack Safety: Auto-Off When Lid Closes"
                android:textColor="@color/dialog_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_low_battery_cutoff"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Battery Guard: Auto-Off Below 20% Unplugged"
                android:textColor="@color/dialog_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_auto_awake_charger"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Plug-in Brew: Auto-Awake on AC Charger"
                android:textColor="@color/dialog_text_primary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_allow_dimming"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Allow Screen Dimming While Keeping Awake"
                android:textColor="@color/dialog_text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_close_settings"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_selected_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
