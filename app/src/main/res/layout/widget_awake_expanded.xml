<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_card_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_card_surface"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. Hero Toggle Container (Outline-free Pastel Blue / Pastel Orange matching app) -->
        <LinearLayout
            android:id="@+id/widget_squircle_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_squircle_empty"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:id="@+id/widget_cup_badge"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_widget_cup_badge_empty"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/img_widget_cup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_cup_empty" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/awake_sans"
                    android:maxLines="1"
                    android:text="Normal Sleep"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/awake_sans"
                    android:maxLines="1"
                    android:text="Tap to keep Googlebook awake"
                    android:textColor="@color/dialog_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_widget_state_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segmented_track"
                android:fontFamily="@font/awake_sans"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="OFF"
                android:textColor="@color/chip_unselected_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Segmented Duration Pill Row (Infinite | 30m | 1h | 2h) -->
        <LinearLayout
            android:id="@+id/widget_duration_track"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segmented_track"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btn_widget_dur_infinite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:background="@drawable/bg_chip_selected"
                android:ellipsize="end"
                android:fontFamily="@font/awake_sans"
                android:gravity="center"
                android:maxLines="1"
                android:text="Infinite"
                android:textColor="@color/chip_selected_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_dur_30"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:ellipsize="end"
                android:fontFamily="@font/awake_sans"
                android:gravity="center"
                android:maxLines="1"
                android:text="30m"
                android:textColor="@color/chip_unselected_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_dur_60"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:ellipsize="end"
                android:fontFamily="@font/awake_sans"
                android:gravity="center"
                android:maxLines="1"
                android:text="1h"
                android:textColor="@color/chip_unselected_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_dur_120"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:ellipsize="end"
                android:fontFamily="@font/awake_sans"
                android:gravity="center"
                android:maxLines="1"
                android:text="2h"
                android:textColor="@color/chip_unselected_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Footer Controls Row (Open Settings Window) -->
        <LinearLayout
            android:id="@+id/widget_footer_row"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_widget_open_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_track"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/awake_sans"
                    android:maxLines="1"
                    android:text="Settings"
                    android:textColor="@color/chip_unselected_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
