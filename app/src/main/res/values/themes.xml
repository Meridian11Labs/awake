<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Zero-window trampoline theme for instant Taskbar left-click routing -->
    <style name="Theme.Awake.Trampoline" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Compact Frosted-Glass Popover Panel (Blur ONLY behind the panel) -->
    <style name="Theme.Awake.GlassPanel" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@drawable/bg_glass_panel</item>
        <item name="android:windowBackgroundBlurRadius">96px</item>
        <item name="android:windowElevation">24dp</item>
        <item name="android:fontFamily">@font/awake_sans</item>
        <item name="fontFamily">@font/awake_sans</item>
    </style>

    <!-- Full Desktop/Googlebook Material 3 Expressive Window Theme (Opaque, No Blur, Seamless Header) -->
    <style name="Theme.Awake.SettingsDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/awake_sans</item>
        <item name="fontFamily">@font/awake_sans</item>
        <item name="colorPrimary">@color/window_bg</item>
        <item name="colorPrimaryDark">@color/window_bg</item>
        <item name="android:colorPrimary">@color/window_bg</item>
        <item name="colorAccent">@color/chip_selected_bg</item>
        <item name="colorControlActivated">@color/chip_selected_bg</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
