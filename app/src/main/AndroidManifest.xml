<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Large-Screen / Googlebook compatibility: do not require a touchscreen -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.app_widgets"
        android:required="false" />
    <!-- Desktop app: offered on Googlebooks (PCs) only -->
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="true" />

    <application
        android:name=".AwakeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher_empty"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_empty"
        android:supportsRtl="true">

        <!-- Target zero-UI trampoline activity (invoked through exported EmptyCupAlias / FullCupAlias) -->
        <activity
            android:name=".ui.ToggleTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Awake.Trampoline" />

        <!-- Alias 1: Half-Empty Coffee Cup (Default Enabled — Normal Suspend/Resume) -->
        <activity-alias
            android:name=".EmptyCupAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_empty"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_empty"
            android:targetActivity=".ui.ToggleTrampolineActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias 2: Completely Filled Coffee Cup (Enabled when Keep Awake is Active) -->
        <activity-alias
            android:name=".FullCupAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_full"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_full"
            android:targetActivity=".ui.ToggleTrampolineActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Zero-UI trampoline for Right-Click Dynamic Shortcut instant actions -->
        <activity
            android:name=".ui.ShortcutActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Awake.Trampoline" />

        <!-- Adaptive Googlebook Control & Settings Window (Opaque, No Blur, handles QS Tile Long-Press) -->
        <activity
            android:name=".ui.SettingsDialogActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Awake.SettingsDialog">
            <layout
                android:defaultHeight="660dp"
                android:defaultWidth="920dp"
                android:gravity="center"
                android:minHeight="500dp"
                android:minWidth="460dp" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Keep-Awake Foreground Service (WakeLock + Guardrail Monitors) -->
        <service
            android:name=".service.KeepAwakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated desktop keep-awake power utility for Googlebooks: holds CPU and display wake locks and monitors hardware lid-close and low-battery guardrails across windows while Keep Awake is explicitly toggled ON by the user via the Taskbar icon, Quick Settings tile, or desktop widget." />
        </service>

        <!-- Companion Quick Settings Tile in System Tray -->
        <service
            android:name=".service.KeepAwakeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_coffee_empty"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 1x1 Default / Resizable Squircle Coffee Cup Toggle Widget -->
        <receiver
            android:name=".widget.AwakeSquircleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/awake_squircle_widget_info" />
        </receiver>

        <!-- Non-exported internal receiver for Widget PendingIntent clicks -->
        <receiver
            android:name=".widget.AwakeWidgetActionReceiver"
            android:exported="false" />

        <!-- Non-exported internal receiver for AlarmManager timed session expiration -->
        <receiver
            android:name=".receiver.SessionExpirationReceiver"
            android:exported="false" />

        <!-- Boot and app-update receiver: resets to OFF on boot, preserves active sessions across updates -->
        <receiver
            android:name=".receiver.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
